[Unit]
Description=EPP performance for desktop latency (amd-pstate-epp)
After=systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do echo performance > "$f" || true; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
